# Aitta access token from https://aitta-auth.csc.fi/myToken
# Copy this file to .env and fill in your key.
OPENAI_API_KEY=

# Model name for the LLM
MODEL_NAME=google/gemma-4-31b-it

# Base URL for the model API
MODEL_BASE_URL=https://aitta-api.csc.fi/openai/v1

# Port the MCP server (04_mcp_server*.py) listens on, and the examples
# that use the MCP capability connect to. Defaults to 8000.
#MCP_PORT=8000
